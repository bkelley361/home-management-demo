{
  "name": "home-management",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c --go",
    "clean": "rm -rf .expo node_modules",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit --ignoreDeprecations 6.0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios-sim": "eas build --profile development-simulator --platform ios",
    "install:ios-sim": "eas build:run --platform ios --latest",
    "install:android": "eas build:run --platform android --latest",
    "build:android:test": "eas build --profile preview --platform android",
    "build:android:local": "eas build --profile preview --platform android --local",
    "build:apk": "eas build --profile preview --platform android --local --output ./home-management.apk",
    "build:apk:dev": "eas build --profile development --platform android --local --output ./home-management-dev.apk",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "submit": "eas submit --profile production --platform all",
    "update": "eas update --channel production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/aspect-ratio": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/collapsible": "^1.5.2",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/hover-card": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/menubar": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/toggle": "^1.5.2",
    "@rn-primitives/toggle-group": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.24",
    "expo-calendar": "~56.0.10",
    "expo-constants": "~56.0.19",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.28",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-image": "~56.0.13",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.19",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.28",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eas-cli": "^27.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss-react-native": "^1.7.10",
    "typescript": "~6.0.3"
  },
  "private": true
}
